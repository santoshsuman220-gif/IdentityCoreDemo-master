@using IdentityCoreDemo.ViewModel
@if(TempData["Message"]!=null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Message!</strong> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MessageError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Message!</strong> @TempData["MessageError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@model LoginViewModel
<div class="container">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-lg-6 p-4 bg-body-tertiary">
            <form method="post">
                <div class="mb-2 p-3 bg-success text-white">
                    <h2 class="text-center">USER LOGIN</h2>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
               
                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input type="email" asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger p-2"></span>
                </div>
                <div>
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger p-2"></span>
                </div>
                <div class="mb-2">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                    <label class="form-check-label">Remember Me</label>
                    <a asp-action="ForgotPassword" class="float-end link-secondary">Forgot Password</a>
                </div>
                <div>
                    <input type="submit" value="Login" class="btn btn-success btn-lg" />
                </div>
            </form>
        </div>
    </div>
</div>
