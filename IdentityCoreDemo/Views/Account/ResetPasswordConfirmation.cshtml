@{
    ViewBag["Title"] = "Password Confirmation";
}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="bg-secondary text-white">
                <h4>Reset Password Confirmation</h4>
            </div>
            <p>
                Your password has been reset successfully, you can now log in to your account with your new password.
            </p>
            <a asp-action="Login" asp-controller="Account" class="btn btn-success">Go to Login</a>
        </div>
    </div>
</div>