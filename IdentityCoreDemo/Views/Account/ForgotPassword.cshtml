@using IdentityCoreDemo.ViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ForgotPasswordViewModel
<div class="container">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-lg-6 p-4 bg-body-tertiary">
            <form method="post">
                <div class="mb-2 p-3 bg-success text-white">
                    <h2 class="text-center">FORGOT PASSWORD</h2>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input type="email" asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger p-2"></span>
                </div>
                <div>
                    <input type="submit" value="Change Password" class="btn btn-success btn-lg" />
                </div>
            </form>
        </div>
    </div>
</div>

