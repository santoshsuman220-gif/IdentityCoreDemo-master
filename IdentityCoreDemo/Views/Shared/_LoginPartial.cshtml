@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> signInManager

<ul class="navbar-nav ms-auto">
    @if(signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link">Welcome User: @User.Identity.Name</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-left mx-2 fs-5" ></i>Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Register"><i class="bi bi-person-fill-add mx-2 fs-5"></i>Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right mx-2 fs-5"></i>Login</a>
        </li>
    }
   
</ul>